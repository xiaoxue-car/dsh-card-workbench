{
    "name": "dsh-card-workbench",
    "version": "1.1.74",
    "private": false,
    "license": "MIT",
    "keywords": [
        "dsh",
        "harness",
        "plugin",
        "butler",
        "cards",
        "sessions",
        "card-workbench",
        "deepseek-harness",
        "task-orchestration",
        "workbench",
        "卡片工坊"
    ],
    "description": "Card workbench for DSH: split work into cards, adopt every work conversation, watch them, unstick them, verify them.",
    "author": "dsh-card-workbench contributors",
    "engines": {
        "dsh": ">=0.2.1-rc.2 <0.3.0-0"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "exports": {
        ".": "./index.js",
        "./client": "./client.js",
        "./locale/*.json": "./locale/*.json",
        "./icon": "./icon.svg"
    },
    "files": [
        "CONTRIBUTING.md",
        "index.js",
        "client.js",
        "cordis.patch.yml",
        "README.md",
        "PUBLISH.md",
        "GITEE.md",
        "LICENSE",
        "screenshots.json",
        "docs/*.md",
        "docs/screenshots/*.png",
        "lib/*.js",
        "scripts/*.mjs",
        "locale/*.json",
        "icon.svg"
    ],
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "immediately": true,
            "inject": [
                "@deepseek-ai/dsh-client-locale",
                "@deepseek-ai/dsh-client-ui-layout",
                "@deepseek-ai/dsh-client-ui-sidebar",
                "@deepseek-ai/dsh-client-ui-workspace"
            ]
        }
    },
    "repository": {
        "type": "git",
        "url": "https://gitee.com/fglry/dsh-card-workbench"
    },
    "homepage": "https://gitee.com/fglry/dsh-card-workbench#readme",
    "bugs": {
        "url": "https://gitee.com/fglry/dsh-card-workbench/issues"
    }
}
